--- !u!114 &7409621060762383277
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5191254466415386658}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03b1018ac666c29c69686461b32a1cbe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Speaker
  textToSpeak:
  - lineText: Thank you for finding my beads!
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: I've been looking for those for a while
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: you seem pretty resourceful, could you give me a hand with something?
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: These strange plants have been popping up all around the place..
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: Here are the keys to the shed, you'll find some shears in there.
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 2767072191123959644}
          m_TargetAssemblyTypeName: Characters.Priest, Assembly-CSharp
          m_MethodName: GivePlayerKey
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - lineText: If you find any of those plants, please cut them out.
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  repeatingTextToSpeak:
  - lineText: I'm here if you ever need to talk.
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  textColor: {r: 0.6784314, g: 0.6784314, b: 0.6784314, a: 1}
  speakSpeed: 1
  lookOffset: {x: 0, y: 3.46, z: 0.06}
  speakBiteAudioClip: {fileID: 8300000, guid: 29d06b0811bb14248abed446c85f4335, type: 3}
  hasSpokenTo: 0
