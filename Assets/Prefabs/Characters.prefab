--- !u!114 &2662587660840582903
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5191254466415386658}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03b1018ac666c29c69686461b32a1cbe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Speaker
  textToSpeak:
  - lineText: Hello.
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: I hope you are settling in well.
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: This place tends to take a toll on people...
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: I'm here if you ever need to talk.
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  repeatingTextToSpeak:
  - lineText: I'm here if you ever need to talk.
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  textColor: {r: 0.6792453, g: 0.6792453, b: 0.6792453, a: 1}
  speakSpeed: 1
  lookOffset: {x: 0, y: 3.46, z: 0.06}
  speakBiteAudioClip: {fileID: 8300000, guid: 29d06b0811bb14248abed446c85f4335, type: 3}
