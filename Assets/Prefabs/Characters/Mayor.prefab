  dialogueSections:
  - sectionName: Welcome Speech
    textToSpeak:
    - lineText: Welcome to The End!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: I am the mayor of this fine town!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: You've got something for me in your boot
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: could you go and grab it for me?
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 0}
            m_TargetAssemblyTypeName: World.Car, Assembly-CSharp
            m_MethodName: OpenBoot
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 6200187551916099236}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Waiting for boot Item
    textToSpeak:
    - lineText: Go grab my thing for me.
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  - sectionName: Waiting to pass Item
    textToSpeak:
    - lineText: Just pass it to me and I'll let you on your way!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  - sectionName: Thanking for Item
    textToSpeak:
    - lineText: Thanks!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: I've got some things for you before you go,
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: take this
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 3681370171269752856}
            m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
            m_MethodName: GiveThing
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
    - lineText: and These are the keys to your new place!
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 3681370171269752856}
            m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
            m_MethodName: GiveKeys
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
    - lineText: Enjoy your stay!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: Enjoy your stay!
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 3681370171269752856}
            m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
            m_MethodName: Spin
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
