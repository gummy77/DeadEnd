              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 6200187551916099236}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 4
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Blocking Gate
    textToSpeak:
    - lineText: Sorry! this area is off limits!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: it will open again once the road is clear!
      onLineFinished:
        m_PersistentCalls:
