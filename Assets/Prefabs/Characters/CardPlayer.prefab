              m_FloatArgument: 0
              m_StringArgument: UnFlipCards
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Lose 2
    textToSpeak:
    - lineText: ooh what a close one...
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: but I still win...
      onLineFinished:
        m_PersistentCalls:
