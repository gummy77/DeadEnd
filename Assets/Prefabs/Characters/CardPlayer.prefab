  dialogueSections:
  - sectionName: Initial Greeting
    textToSpeak:
    - lineText: Hello there..
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: would you like to play a game of cards?
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: its quite simple
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: 
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 4549352246627362370}
            m_TargetAssemblyTypeName: CardPlayer, Assembly-CSharp
