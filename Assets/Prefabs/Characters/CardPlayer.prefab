              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: UnFlipCards
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Lose 3
    textToSpeak:
    - lineText: you tried your best...
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: but the victory goes to me!
