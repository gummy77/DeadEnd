              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Loop playing
    textToSpeak:
    - lineText: Want to try your luck again?
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: 
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 4549352246627362370}
            m_TargetAssemblyTypeName: CardPlayer, Assembly-CSharp
