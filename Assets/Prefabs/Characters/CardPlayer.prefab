              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Lose 1
    textToSpeak:
    - lineText: 'You lose!!! '
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: hehehe I guess I really am the best...
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 6861529486983923878}
