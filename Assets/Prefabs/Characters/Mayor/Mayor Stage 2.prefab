--- !u!114 &5960279094338056112
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4571305242851581072}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2be48b1b501641889e6e8c8c588cad1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSpeaker
  dialogueColor: {r: 0.8509804, g: 0.8039216, b: 0.6431373, a: 1}
  dialogueSpeed: 1
  lookOffset: {x: 0, y: 1.21, z: 0}
  speakBiteAudioClip: {fileID: 8300000, guid: 2bbc601c150fa064a9a13c31a3fb5864, type: 3}
  dialogueSections:
  - sectionName: Welcome Speech
    textToSpeak:
    - lineText: Welcome to The End!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: I am the mayor of this fine town!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: You've got something for me in your trunk
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: could you go and grab it for me?
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 0}
            m_TargetAssemblyTypeName: World.Car, Assembly-CSharp
            m_MethodName: OpenBoot
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 5960279094338056112}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Waiting for boot Item
    textToSpeak:
    - lineText: could you go grab whats in your trunk for me?
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  - sectionName: Waiting to be handed item
    textToSpeak:
    - lineText: Just pass me the Item!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  - sectionName: Thanking for Item
    textToSpeak:
    - lineText: Thanks!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: I've got some things for you before you go,
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: take this
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 0}
            m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
            m_MethodName: GiveThing
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
    - lineText: and These are the keys to your new place!
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 0}
            m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
            m_MethodName: GiveKeys
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
