  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSpeaker
  dialogueColor: {r: 0.6784314, g: 0.6784314, b: 0.6784314, a: 1}
  dialogueSpeed: 1
  lookOffset: {x: 0, y: 3.46, z: 0.08}
  speakBiteAudioClip: {fileID: 8300000, guid: 29d06b0811bb14248abed446c85f4335, type: 3}
  dialogueSections:
  - sectionName: Sad Talk
    textToSpeak:
    - lineText: Hello again
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: Thanks for cleaning up some of those plants
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: Do you mind if I confide in you for a moment?
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: 
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: We've lost so many townspeople lately...
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: I'm beginning to fear we may not be able to stay afloat...
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: Especially with the bridge being broken
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: I hope everyone over there is okay...
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: if you find the groundskeeper you may be able to help him with that.
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 2639985694760178112}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 0}
            m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
            m_MethodName: SetActive
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 0}
            m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
            m_MethodName: SetActive
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 1
            m_CallState: 2
  - sectionName: Loop
    textToSpeak:
    - lineText: The groundskeeper probably needs help with the bridge.
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  dialogueSectionIndex: 0
  dialogueEnabled: 1
