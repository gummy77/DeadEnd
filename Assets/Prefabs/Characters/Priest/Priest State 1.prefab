--- !u!114 &4317310488355003041
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1637128192530980113}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2be48b1b501641889e6e8c8c588cad1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSpeaker
  dialogueColor: {r: 0.6784314, g: 0.6784314, b: 0.6784314, a: 1}
  dialogueSpeed: 1
  lookOffset: {x: 0, y: 3.46, z: 0.08}
  speakBiteAudioClip: {fileID: 8300000, guid: 29d06b0811bb14248abed446c85f4335, type: 3}
  dialogueSections:
  - sectionName: Initial Dialogue
    textToSpeak:
    - lineText: Hello.
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: I hope you are settling in well.
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: This place tends to take a toll on people...
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: I'm here if you ever need to talk.
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 4317310488355003041}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Initial loop
    textToSpeak:
    - lineText: I'm here if you ever need to talk.
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  - sectionName: Found Beads
    textToSpeak:
    - lineText: Thank you for finding my beads!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: I've been looking for those for a while
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: you seem pretty resourceful, could you give me a hand with something?
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: These strange plants have been popping up all around the place..
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: Here are the keys to the shed, you'll find some shears in there.
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 4273932290766083337}
            m_TargetAssemblyTypeName: Characters.Priest, Assembly-CSharp
            m_MethodName: GivePlayerKey
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
    - lineText: If you find any of those plants, please cut them out.
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 4317310488355003041}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 3
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 0}
            m_TargetAssemblyTypeName: Characters.Guy, Assembly-CSharp
            m_MethodName: EatMeat
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 3
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Found Beads Loop
    textToSpeak:
    - lineText: If you find any of those plants, please cut them out.
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  dialogueSectionIndex: 0
  dialogueEnabled: 1
