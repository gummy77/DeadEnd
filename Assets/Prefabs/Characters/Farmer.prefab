MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5163487748004175122}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2be48b1b501641889e6e8c8c588cad1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSpeaker
  dialogueColor: {r: 0.7529412, g: 0.7019608, b: 0.32941177, a: 1}
  dialogueSpeed: 1
  lookOffset: {x: 0, y: 2.6, z: 0}
  speakBiteAudioClip: {fileID: 8300000, guid: 18b66c93b04f8d62d8796c1218c42bea, type: 3}
  dialogueSections:
  - sectionName: Initial Dialogue
    textToSpeak:
    - lineText: hello stranger!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: do you have any experience in growing sunflowers?
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: mine wont stop crying blood
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: not sure what to do here...
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 5681515601383945082}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Initial Loop
    textToSpeak:
    - lineText: not sure whaat to do here...
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  - sectionName: Sword Removed
    textToSpeak:
    - lineText: Did you do something in there?
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: The sunflowers are crying a lot quieter now...
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: Thanks if you did!
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 5681515601383945082}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 3
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Thanks for Helping Loop
    textToSpeak:
    - lineText: Thanks for helping if you did!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  - sectionName: Planks?
    textToSpeak:
    - lineText: hello!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: Oh? looking for those planks?
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: unfortunately I've moved them into the field
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: I was planning on using them for something
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: but you can have them if its for the bridge!
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 5681515601383945082}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 5
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Planks Loop
    textToSpeak:
    - lineText: unfortunately I've moved those planks into the field
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: but you can have them if its for the bridge!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  - sectionName: Collected Planks Loop
    textToSpeak:
    - lineText: Oh you found them? nice!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: good luck with the bridge!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  dialogueSectionIndex: 0
  dialogueEnabled: 1
