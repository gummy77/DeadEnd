  speakBiteAudioClip: {fileID: 8300000, guid: 18b66c93b04f8d62d8796c1218c42bea, type: 3}
  dialogueSections:
  - sectionName: Initial Dialogue
    textToSpeak:
    - lineText: hello stranger!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: do you have any experience in growing sunflowers?
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: mine wont stop crying blood
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: not sure what to do here...
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 5681515601383945082}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 1
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Initial Loop
    textToSpeak:
    - lineText: not sure whaat to do here...
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  - sectionName: Sword Removed
    textToSpeak:
    - lineText: Did you do something in there?
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: The sunflowers are crying a lot quieter now...
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
    - lineText: Thanks if you did!
      onLineFinished:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 5681515601383945082}
            m_TargetAssemblyTypeName: DialogueSpeaker, Assembly-CSharp
            m_MethodName: MoveDialogueSection
            m_Mode: 3
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 3
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  - sectionName: Thanks for Helping Loop
    textToSpeak:
    - lineText: Thanks for helping if you did!
      onLineFinished:
        m_PersistentCalls:
          m_Calls: []
  dialogueSectionIndex: 0
  dialogueEnabled: 1
