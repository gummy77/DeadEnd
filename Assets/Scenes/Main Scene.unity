--- !u!114 &1149589617
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1149589614}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03b1018ac666c29c69686461b32a1cbe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Speaker
  textToSpeak:
  - lineText: Welcome to The End!
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: I am the mayor of this fine town!
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: Here! ive got some things for you
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: take this
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 920963165}
          m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
          m_MethodName: GiveThing
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - lineText: and these are the keys to your new place !
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 920963165}
          m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
          m_MethodName: GiveKeys
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - lineText: 
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 920963165}
          m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
          m_MethodName: Spin
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  repeatingTextToSpeak:
  - lineText: Sorry! this area is off limits!
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: it will open again once the road is clear!
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  textColor: {r: 0.7924528, g: 0.7409387, b: 0.55695975, a: 1}
  speakSpeed: 0.75
  lookOffset: {x: 0, y: 1.21, z: 0}
  speakBiteAudioClip: {fileID: 8300000, guid: 2bbc601c150fa064a9a13c31a3fb5864, type: 3}
  hasSpokenTo: 0
