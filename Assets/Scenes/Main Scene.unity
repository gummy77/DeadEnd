  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Speaker
  textToSpeak:
  - lineText: Welcome to The End!
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: I am the mayor of this fine town!
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: Here! ive got some things for you
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls: []
  - lineText: take this
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 920963165}
          m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
          m_MethodName: GiveThing
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - lineText: and these are the keys to your new place !
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 920963165}
          m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
          m_MethodName: GiveKeys
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - lineText: 
    isDefaultColor: 1
    lineColor: {r: 0, g: 0, b: 0, a: 0}
    onLineFinished:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 920963165}
          m_TargetAssemblyTypeName: Characters.Mayor, Assembly-CSharp
          m_MethodName: Spin
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
